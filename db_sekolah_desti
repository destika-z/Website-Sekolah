INSERT INTO `jurusan` (`id`, `nama`, `keterangan`, `gambar`, `created_at`, `updated_at`) VALUES
(1, 'ULP/UPW', 'Program keahlian Usaha Layanan Pariwisata (ULP) yang sebelumnya bernama Kompetensi Keahlian Usaha Perjalanan Pariwisata (UPW) merupakan program keahlian yang mempelajari kegiatan yang bersifat komersial yang mengatur, menyediakan, dan menyelenggarakan pelayanan bagi seseorang, sekelompok orang yang melakukan perjalanan dengan tujuan utama yaitu berwisata.', 'jurusan1775886294.png', '2021-09-01 15:17:41', '2026-04-11 12:44:54'),
(2, 'BC', 'Program Keahlian Broadcasting dan Perfilman merupakan jurusan yang mempelajari keterampilan produksi media audio visual seperti film, televisi, dan siaran radio. Program ini dirancang untuk membekali siswa dengan pengetahuan dan kemampuan teknis serta kreatif di bidang penyiaran dan perfilman', 'jurusan1775886242.png', '2021-09-01 15:18:12', '2026-04-11 12:44:02'),
(3, 'Otomotif', 'Program Keahlian Teknik Otomotif yang sebelumnya bernama Kompetensi Keahlian Teknik Kendaraan Ringan adalah ilmu yang mempelajari tentang alat-alat transportasi darat yang menggunakan mesin, terutama mobil yang mulai berkembang sebagai cabang ilmu seiring dengan diciptakannya mesin mobil. Dalam perkembangannya, mobil semakin menjadi alat transportasi yang kompleks yang terdiri dari ribuan komponen yang tergolong dalam puluhan system dan subsistem. Oleh karena itu, Teknik Otomotif pun berkembang menjadi ilmu yang luas dan mencakup semua system dan subsistem.', 'jurusan1775886166.png', '2021-09-01 15:18:35', '2026-04-11 12:43:18'),
(4, 'TKIN', 'Teknik Pengolahan Migas dan Petrokimia (TPMP) merupakan kompetensi keahlian kelima yang diselenggarakan di SMK Negeri 1 Padaherang. Dengan harapan dapat diselaraskan dengan Kompetensi Keahlian Geologi Pertambangan dan memenuhi kebutuhan akan tenaga di bidang Migas dan Petrokimia. Teknik Pengolahan Migas dan Petrokimia (TPMP) merupakan kompetensi keahlian kelima yang diselenggarakan di SMK Negeri 1 Padaherang. Dengan harapan dapat diselaraskan dengan Kompetensi Keahlian Geologi Pertambangan dan memenuhi kebutuhan akan tenaga di bidang Migas dan Petrokimia.', 'jurusan1775886122.png', '2021-09-01 15:18:56', '2026-04-11 12:42:02'),
(5, 'TEIN', 'Kompetensi Keahlian Teknik Elektronika Industri (TEIN) mendidik siswa agar mempunyai kemampuan / keterampilan kepada anak didik pada bidang sistem kontrol dan maintenance peralatan industri berbasis electrical control dan micro processor. Kompetensi tersebut meliputi pengetahuan dan keterampilan elektronika umum, mikrokontroller dan mikroprocessor, pneumatic dan PLC, programming berbasis komputer yang erat kaitannya dengan proses produksi di Industri.', 'jurusan1775886025.png', '2021-09-01 15:19:09', '2026-04-11 12:40:25'),
(7, 'PPLG', 'Program Keahlian Pengembangan Perangkat Lunak dan Gim (PPLG), sebelumnya dikenal sebagai Rekayasa Perangkat Lunak (RPL), merupakan salah satu jurusan unggulan di SMKN 1 Padaherang. Sejak didirikan pada tahun 2007, jurusan ini telah berkomitmen untuk membekali siswa dengan keterampilan dan pengetahuan di bidang teknologi informasi, khususnya dalam pengembangan perangkat lunak (software) komputer, website dan aplikasi/game Android.', 'jurusan1775885983.png', '2026-04-11 00:38:28', '2026-04-11 12:39:43'),
(8, 'TJKT', 'Kompetensi Keahlian Teknik Komputer dan Jaringan (TKJ) merupakan model pendidikan kejuruan yang berbasis teknologi informasi dan komunikasi. Teknik komputer dan jaringan saat ini keberadaannya sudah mulai terlihat dimata publik, dimana kompetensi keahlian ini merupakan jurusan yang sudah mendekati ilmu praktisi yang langsung dapat diimplementasikan dilingkungan dunia kerja profesional. ', 'jurusan1775885902.png', '2026-04-11 00:38:44', '2026-04-11 12:38:38'),
(9, '  TGP', 'Geologi pertambangan adalah suatu ilmu yang mempelajari dan mengembangkan pengetahuan yang berkaitan dengan kebumian seperti, bentuk muka bumi, material penyusun bumi, jenis batuan, sifat-sifat fisika dan kimia, bentuk batuan, proses pembentukannya dan sejarah bumi serta geologi terapannya seperti Geologi Minyak dan Gas Bumi, Geologi Teknik, Hidro Geologi, Geologi Tata Lingkungan, Geologi Tambang dan lain-lain. ', 'jurusan1775885667.png', '2026-04-11 00:39:00', '2026-04-11 12:36:32');

